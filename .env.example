# OpenRouter API Configuration
# Obtenha sua chave em: https://openrouter.ai/keys
# NOTA: O sistema pode funcionar sem API key para testes básicos
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Rate Limiting Configuration (OpenRouter limits)
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_TOKENS_PER_MINUTE=100000
RETRY_ATTEMPTS=3
RETRY_DELAY=2.0
BACKOFF_FACTOR=3.0

# Default model for all agents (can be overridden per agent)
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# Agent-specific Models
PLANNER_MODEL=openai/gpt-4o-mini
GENERATOR_MODEL=openai/gpt-4o-mini
COMPILER_CORRECTOR_MODEL=openai/gpt-4o-mini
TEST_CORRECTOR_MODEL=openai/gpt-4o-mini

# System Configuration
JAVA_VALIDATION_ENABLED=true
MAX_GENERATION_ATTEMPTS=5
MAX_COMPILE_CORRECTION_ATTEMPTS=2
MAX_TEST_CORRECTION_ATTEMPTS=3

# Logging Configuration
LOG_LEVEL=INFO

# Maven Configuration
MAVEN_TIMEOUT=300
MAVEN_MEMORY=2g

# Test Generation Configuration
DEFAULT_TIMEOUT=30
GENERATE_NEGATIVE_TESTS=true
INCLUDE_PERFORMANCE_TESTS=false

